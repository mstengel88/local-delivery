# Copy to bridge.env on GHOS, set mode 600, and never commit the real file.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.ghstickets.com
APP_URL=https://app.ghstickets.com
HOST=https://app.ghstickets.com
SHOPIFY_STORE_DOMAIN=darfaz-2e.myshopify.com
SHOP_CUSTOM_DOMAIN=
SCOPES=read_customers,write_shipping,read_draft_orders,write_draft_orders,read_payment_terms,read_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# Dedicated database/user in the existing GHOS PostgreSQL container.
DATABASE_URL=postgresql://shopify_bridge:REPLACE_ME@ghos-postgres:5432/shopify_bridge?schema=public

# Existing Local-Delivery pricing/rules source during the first cutover.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
SHOPIFY_GATEWAY_SECRET=
QUOTE_ACCESS_COOKIE_SECRET=
ADMIN_QUOTE_PASSWORD=
QUOTE_TAX_RATE=0.05

# Temporary LAN validation listener. Cloudflare remains the production ingress.
BRIDGE_BIND_ADDRESS=0.0.0.0
BRIDGE_LAN_PORT=8086
