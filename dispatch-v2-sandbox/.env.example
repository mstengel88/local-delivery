SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DISPATCH_ADMIN_EMAILS=owner@example.com,manager@example.com
PORT=3010

# Optional: needed for /imports Shopify intake and quote Send to Shopify.
# Use the staying Local-Delivery Shopify app, not the removed contractor app.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Also accepted: SHOPIFY_STORE_DOMAIN or SHOPIFY_SHOP
# Option A: permanent/custom app token
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token
# Option B: API key and secret/client credentials
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET=your-api-secret
# Also accepted for the secret: SHOPIFY_API_SECRET_KEY, SHOPIFY_CLIENT_SECRET, SHOPIFY_CLIENT_SECRET_KEY
# Optional safety rails for the dispatch app: set Local-Delivery's API key here and
# list old/removed app keys so fulfillment/import never silently uses the wrong app.
LOCAL_DELIVERY_SHOPIFY_CLIENT_ID=your-local-delivery-api-key
REMOVED_CONTRACTOR_SHOPIFY_CLIENT_IDS=old-contractor-api-key
# Only set this to true if you intentionally want dispatch to reuse Shopify Session
# rows instead of the Local-Delivery API key/secret client-credentials flow.
SHOPIFY_PREFER_SESSION_TOKEN=false
SCOPES=read_customers,write_customers,read_shipping,write_draft_orders,read_payment_terms,write_payment_terms,write_metaobject_definitions,write_metaobjects,write_products,write_shipping,read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders
SHOPIFY_API_VERSION=2026-01
# Shopify's active carrier callback. Customer and contractor quote estimates use
# this same endpoint so Dispatch V2 and Shopify show the same delivery charge.
SHOPIFY_CARRIER_RATE_URL=https://shipcalc.ghstickets.com/api/carrier-service
DISPATCH_IMPORT_SECRET=change-this-long-random-secret
# Loader and driver screens open this authenticated Dispatch endpoint. It signs
# a short-lived link before redirecting the embedded preview to GHOS.
LOADER_TICKET_CREATOR_URL=/api/loader-ticket-preview
GHOS_TICKET_PREVIEW_URL=https://ghos.ghstickets.com/ticketing/preview

# Optional: read-only GHOS order and delivery synchronization.
# Use a unique secret and send it only in the x-ghos-secret request header.
GHOS_INTEGRATION_SECRET=change-this-to-a-different-long-random-secret

# Optional: needed for route time/mileage calculations
GOOGLE_MAPS_API_KEY=your-google-maps-key
# Optional: needed for /map browser display. Enable Maps JavaScript API and restrict this key by HTTP referrer.
GOOGLE_MAPS_BROWSER_API_KEY=your-browser-google-maps-key
DISPATCH_SHOP_ADDRESS=Green Hills Supply, W180N6368 Marcy Road, Menomonee Falls, WI 53051
DISTANCE_CALC_SECRET=change-this-long-random-secret

# Optional: needed to email customers when a driver marks a stop delivered.
# Verify your sending domain with Resend, then use an address on that domain.
RESEND_API_KEY=re_your-resend-api-key
DISPATCH_EMAIL_FROM=Green Hills Supply <dispatch@yourdomain.com>
DISPATCH_EMAIL_REPLY_TO=dispatch@yourdomain.com
PUBLIC_APP_URL=https://dispatch.winterwatch-pro.info

# Optional: quote tax rates. These are product-only because Shopify shop taxShipping=false.
# Configure these to match Shopify draft-order tax calculation for your store.
QUOTE_TAX_RATE=0.05
QUOTE_MILWAUKEE_CITY_TAX_RATE=0.079
QUOTE_MILWAUKEE_COUNTY_TAX_RATE=0.059
QUOTE_MILWAUKEE_COUNTY_CITIES=Bayside,Brown Deer,Cudahy,Fox Point,Franklin,Glendale,Greendale,Greenfield,Hales Corners,Oak Creek,River Hills,Shorewood,South Milwaukee,St. Francis,Wauwatosa,West Allis,West Milwaukee,Whitefish Bay
